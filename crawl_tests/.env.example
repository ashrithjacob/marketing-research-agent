# Copy to .env and fill in — OR leave this file alone entirely.
#
# common.py looks for secrets in this order and uses the first file it finds:
#   1. crawl_tests/.env            (this directory)
#   2. ../.env
#   3. ../deploy/vps/.env
#
# The mra .env already has FIRECRAWL_API_KEY and APIFY_TOKEN, so on this laptop
# the scripts work with no .env here at all. Anything already exported in the
# shell wins over a file.

# Firecrawl — crawl_firecrawl.py. https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Apify — crawl_apify.py. THIS ONE SPENDS MONEY against a real card.
APIFY_TOKEN=

# Anakin — crawl_anakin.py. Your own instance; free.
ANAKIN_BASE_URL=http://localhost:8080
# Only if you started anakin with API_KEY set.
ANAKIN_LOCAL_API_KEY=
