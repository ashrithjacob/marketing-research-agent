#!/usr/bin/env bash
# `mra` — drive and inspect the research cockpit, the same way every time.
#
# This exists so that "does it work?" has one answer produced by one command,
# instead of a different improvised curl in every session. Run `mra help`.
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
LOCAL_URL="${MRA_LOCAL_URL:-http://localhost:8080}"
LIVE_URL="${MRA_LIVE_URL:-https://marketing.vanis.ai}"
JAR="${TMPDIR:-/tmp}/mra-cookies.txt"

die()  { printf '%s\n' "$*" >&2; exit 1; }
note() { printf '==> %s\n' "$*"; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is not installed, and $2 needs it."
}

# --- the gate --------------------------------------------------------------
# One command that has to pass before any change is called done. Order is
# cheapest-first so a failure arrives quickly.
cmd_check() {
  local failed=0 scope_server=1 scope_frontend=1

  # `--changed` runs only the parts whose inputs moved. The Stop hook uses it so
  # that ending a turn costs a few seconds rather than sixteen; type-checking
  # the server after a CSS change proves nothing. Run plain `mra check` — the
  # whole thing — before a deploy or a commit.
  if [ "${1:-}" = "--changed" ] && git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
    [ -n "$(git -C "$REPO" status --porcelain -- server)" ] || scope_server=0
    [ -n "$(git -C "$REPO" status --porcelain -- frontend/src frontend/index.html)" ] || scope_frontend=0
  fi

  note "conventions"
  node "$REPO/server/scripts/check-conventions.mjs" || failed=1
  if [ "$scope_server" -eq 1 ]; then
    note "server typecheck"
    (cd "$REPO/server" && npm run typecheck --silent) || failed=1
    note "server tests"
    (cd "$REPO/server" && npm test --silent >/dev/null 2>&1) \
      && echo "tests pass" \
      || { (cd "$REPO/server" && npm test --silent); failed=1; }
  else
    note "server unchanged — skipped (run \`mra check\` with no flag to force)"
  fi
  if [ "$scope_frontend" -eq 1 ]; then
    note "frontend build (this is also its only typecheck)"
    (cd "$REPO/frontend" && npm run build >/dev/null 2>&1) \
      && echo "build ok" \
      || { (cd "$REPO/frontend" && npm run build); failed=1; }
  else
    note "frontend unchanged — skipped"
  fi
  # The build writes dist. Re-run the convention checks so a stale dist that
  # the build has just refreshed is reported as needing a commit, not missed.
  local conventions
  conventions=$(node "$REPO/server/scripts/check-conventions.mjs" 2>&1) || { echo "$conventions"; failed=1; }
  if [ "$failed" -eq 0 ]; then
    note "clean"
  else
    note "FAILED — see above. Nothing is done until this passes."
  fi
  return "$failed"
}

# --- the stack -------------------------------------------------------------
cmd_up() {
  need docker "mra up"
  note "docker compose up -d --build (never do this on the VPS — no swap)"
  (cd "$REPO" && docker compose up -d --build) || return 1
  cmd_health local
}

cmd_down() { need docker "mra down"; (cd "$REPO" && docker compose down); }

cmd_logs() {
  need docker "mra logs"
  (cd "$REPO" && docker compose logs --tail "${1:-80}" mra)
}

cmd_health() {
  need curl "mra health"
  local where="${1:-local}" url code
  case "$where" in
    local) url="$LOCAL_URL" ;;
    live)  url="$LIVE_URL" ;;
    *)     die "mra health takes 'local' or 'live', not '$where'" ;;
  esac
  # On a connection failure curl still prints 000 and exits non-zero, so a
  # `|| echo 000` here appends a second 000 and you get "000000".
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "$url/api/health" 2>/dev/null)
  [ -n "$code" ] || code=000
  printf '%s %s/api/health -> %s\n' "$where" "$url" "$code"
  [ "$code" = "200" ]
}

# --- runs ------------------------------------------------------------------
# Auth: locally MRA_APP_PASSWORD_HASH is usually empty, which disables login
# entirely. Against the live site, export MRA_PASSWORD first.
api() {
  local method="$1" path="$2" body="${3:-}" url="${BASE:-$LOCAL_URL}"
  if [ -n "$body" ]; then
    curl -s -b "$JAR" -c "$JAR" -X "$method" "$url$path" \
      -H 'content-type: application/json' -d "$body"
  else
    curl -s -b "$JAR" -c "$JAR" -X "$method" "$url$path"
  fi
}

cmd_login() {
  need curl "mra login"
  [ -n "${MRA_PASSWORD:-}" ] || die \
    "Set MRA_PASSWORD first. It is not in .env — .env holds only the scrypt
hash (MRA_APP_PASSWORD_HASH). Locally that hash is usually empty, which
disables login altogether, so you probably do not need this at all."
  local user="${MRA_APP_USER:-ash}"
  api POST /api/auth/login \
    "$(printf '{"username":"%s","password":"%s"}' "$user" "$MRA_PASSWORD")"
  echo
}

cmd_run() {
  need curl "mra run"; need jq "mra run"
  local product="${1:-}"
  [ -n "$product" ] || die 'usage: mra run "<product name or https://url>"   (MARKETS="US,GB" COMPETITORS="a;b")'
  # A url goes in product_url, never product_name: the server refuses the
  # second, because an agent searching for a url string comes back wrong.
  local payload
  if [[ "$product" =~ ^https?:// ]]; then
    payload=$(jq -nc --arg u "$product" '{product_url:$u}')
  else
    payload=$(jq -nc --arg p "$product" '{product_name:$p}')
  fi
  payload=$(printf '%s' "$payload" | jq -c --arg m "${MARKETS:-US}" --arg c "${COMPETITORS:-}" \
    '.markets = ($m | split(",")) | .known_competitors = ($c | split(";") | map(select(. != "")))')
  local out; out=$(api POST /api/research/runs "$payload")
  printf '%s\n' "$out" | jq -e '.run.id' >/dev/null 2>&1 || die "start refused: $out"
  printf '%s\n' "$out" | jq -r '"run \(.run.id)  status=\(.run.status)"'
  printf '%s\n' "$out" | jq -r '.run.id' > "${TMPDIR:-/tmp}/mra-last-run"
  echo "next: mra watch, then mra confirm once it is awaiting_confirmation"
}

cmd_confirm() {
  need curl "mra confirm"; need jq "mra confirm"
  local id="${1:-$(cat "${TMPDIR:-/tmp}/mra-last-run" 2>/dev/null || true)}"
  [ -n "$id" ] || die "usage: mra confirm [runId]   (accepts the product and competitors exactly as resolved)"
  local body; body=$(api GET "/api/research/runs/$id")
  [ "$(jq -r .run.status <<<"$body")" = "awaiting_confirmation" ] || die "run $id is $(jq -r .run.status <<<"$body"), not awaiting_confirmation"
  local payload; payload=$(jq -c '.run.resolution | {product_url: .product.url, competitors: [.competitors[] | {brand, product_name, url}]}' <<<"$body")
  jq -r '"product: \(.product_url)", "competitors: \(.competitors | map(.brand) | join(", "))"' <<<"$payload"
  local out; out=$(api POST "/api/research/runs/$id/confirm" "$payload")
  jq -e '.run.status' >/dev/null 2>&1 <<<"$out" || die "confirm refused: $out"
  jq -r '"run \(.run.id)  status=\(.run.status)"' <<<"$out"
}

cmd_rerun() {
  need curl "mra rerun"; need jq "mra rerun"
  local id="${1:-$(cat "${TMPDIR:-/tmp}/mra-last-run" 2>/dev/null || true)}"
  [ -n "$id" ] || die "usage: mra rerun [runId] [stage...]   (runs again the named stages and what uses them, or with none every stage that did not complete; spends money)"
  shift || true
  local stages; stages=$(printf '%s\n' "$@" | jq -R . | jq -sc 'map(select(. != ""))')
  local out; out=$(api POST "/api/research/runs/$id/rerun" "{\"stages\":$stages}")
  jq -e '.run.status' >/dev/null 2>&1 <<<"$out" || die "rerun refused: $out"
  jq -r '"run \(.run.id)  status=\(.run.status)"' <<<"$out"
}

cmd_watch() {
  need curl "mra watch"; need jq "mra watch"
  local id="${1:-$(cat "${TMPDIR:-/tmp}/mra-last-run" 2>/dev/null || true)}"
  [ -n "$id" ] || die "usage: mra watch <runId>   (or run one first)"
  local status="" body
  while :; do
    body=$(api GET "/api/research/runs/$id")
    jq -e '.run' >/dev/null 2>&1 <<<"$body" || die "no run $id: $body"
    status=$(printf '%s' "$body" | jq -r '.run.status')
    printf '\r%s  %s   ' "$id" "$status"
    case "$status" in
      resolving|running|stopping) sleep 5 ;;
      *) echo; break ;;
    esac
  done
  printf '%s' "$body" | jq '{status: .run.status, error: .run.error, cost_usd: .run.cost_usd,
    stages: (.run.stage_status | with_entries(select(.value.status != "not_built")) | map_values({status, summary, error})),
    competitors: [.competitors[] | {brand, relationship, form_factor}]}'
  # `invalid` is not `failed`: an agent finished and submitted something its
  # schema or code checks refused, which is the most informative failure here.
  case "$status" in
    invalid) echo "(invalid: an agent's submit was refused; see \`mra calls $id\`)" ;;
    awaiting_confirmation) echo "(waiting for you: \`mra confirm $id\`, or confirm in the cockpit)" ;;
  esac
}

cmd_calls() {
  need curl "mra calls"; need jq "mra calls"
  local id="${1:-$(cat "${TMPDIR:-/tmp}/mra-last-run" 2>/dev/null || true)}"
  [ -n "$id" ] || die "usage: mra calls <runId>"
  api GET "/api/research/runs/$id/calls" \
    | jq '[.calls[] | {seq, agent_id, model, stop_reason, error, tokens: .usage.totalTokens, billed_cost}]'
}

# --- the deploy ------------------------------------------------------------
cmd_trace() {
  need curl "mra trace"
  local id="${1:-$(cat "${TMPDIR:-/tmp}/mra-last-run" 2>/dev/null || true)}"
  [ -n "$id" ] || die "usage: mra trace <runId> [file]"
  local out="${2:-run-$id-trace.log}" code
  code=$(curl -s -b "$JAR" -c "$JAR" -o "$out" -w '%{http_code}' "${BASE:-$LOCAL_URL}/api/research/runs/$id/trace")
  [ "$code" = "200" ] || { rm -f "$out"; die "no trace for $id (HTTP $code)"; }
  note "$(wc -l < "$out") lines, $(du -h "$out" | cut -f1) → $out"
}

cmd_deployed() {
  need curl "mra deployed"
  cmd_health live || true
  note "image on the VPS"
  ssh owui 'docker inspect -f "{{.Image}} created {{.Created}}" mra 2>/dev/null || echo "container mra not running"' 2>/dev/null \
    || echo "(could not reach the VPS over ssh)"
  note "uncommitted work here"
  git -C "$REPO" status --porcelain | head -20
  echo
  echo "Live health being 200 says the container is up. It does NOT say your"
  echo "change is on it. Only a deploy does that:"
  echo "  bash deploy/vps/deploy.sh    (from the repo root, builds locally)"
}

cmd_help() {
  cat <<'HELP'
mra — drive and inspect the research cockpit

  check [--changed]        tests + typecheck + conventions + frontend build.
                           The gate. Nothing is done until this passes.
                           --changed runs only the parts whose inputs moved.

  up                       docker compose up -d --build, then health
  down                     stop the stack (volumes keep your runs)
  logs [n]                 last n lines from the mra container
  health [local|live]      /api/health against localhost or marketing.vanis.ai

  login                    session cookie (needs MRA_PASSWORD; usually
                           unnecessary locally, where login is disabled)
  run "<product>"          start an analysis: a url goes to product_url, a name
                           to product_name. MARKETS="US,GB" (default US),
                           COMPETITORS="brand a;brand b". It resolves the
                           product and proposes competitors, then waits.
  confirm [runId]          accept the product and competitors as resolved and
                           start the stages (the cockpit lets you edit them)
  rerun [runId] [stage...] run again the named stages (product_market, reviews,
                           competitor_ads, avatars) and every stage that uses
                           them; with none, every stage that did not complete.
                           Other stages are kept (spends money)
  watch [runId]            poll until the run waits for you or ends, then print
                           its stages and competitors
  calls [runId]            the LLM call log, one line per turn
  trace [runId] [file]     download the run's trace: one line per function
                           and per HTTP request, each tagged with its file

  deployed                 what is actually live, and what is not yet shipped

Against the live site: BASE=https://marketing.vanis.ai mra watch <id>
HELP
}

case "${1:-help}" in
  check)    shift; cmd_check "$@" ;;
  up)       shift; cmd_up "$@" ;;
  down)     shift; cmd_down "$@" ;;
  logs)     shift; cmd_logs "$@" ;;
  health)   shift; cmd_health "$@" ;;
  login)    shift; cmd_login "$@" ;;
  run)      shift; cmd_run "$@" ;;
  confirm)  shift; cmd_confirm "$@" ;;
  rerun)    shift; cmd_rerun "$@" ;;
  watch)    shift; cmd_watch "$@" ;;
  calls)    shift; cmd_calls "$@" ;;
  trace)    shift; cmd_trace "$@" ;;
  deployed) shift; cmd_deployed "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command '$1'. Try: mra help" ;;
esac
